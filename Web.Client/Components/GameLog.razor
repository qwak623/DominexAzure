@using Microsoft.AspNetCore.SignalR.Client;
@inject NavigationManager Navigation

<div class="gameLog">
    @*<button @onclick="AppendLog">Append Log</button>*@
    @if (Log is not null)
    {
        foreach (var record in Log)
        {
            <div>
                <span>@record</span>
            </div>
        }
    }
</div>