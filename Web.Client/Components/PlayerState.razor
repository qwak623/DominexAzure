<div class="row">
    <div class="col-6">
        <span>@PlayerStateDto?.GamePhase</span>
    </div>
    <div>
        <span>Actions: @PlayerStateDto?.Actions</span>
        <span>Buys: @PlayerStateDto?.Buys</span>
        <span>Coins: @PlayerStateDto?.Coins</span>
    </div>
    <div class="d-flex flex-row gap-2">
        <div class="p-1">Hand:</div>
        @if (PlayerStateDto is not null)
        {
            foreach (var card in PlayerStateDto.Hand)
            {
                <CardComponent Card="card" />
            }
        }
    </div>
</div>