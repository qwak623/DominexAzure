<div class="workspace">
    @if (Cards is not null)
    {
        foreach (var card in (Cards ?? new List<string>()))
        {
            <HxButton Color="ThemeColor.Secondary" OnClick="() => SelectCard(card)">@card</HxButton>
        }
        <HxButton Color="ThemeColor.Secondary" OnClick="() => SelectCard(null)">None</HxButton>
    }
</div>
