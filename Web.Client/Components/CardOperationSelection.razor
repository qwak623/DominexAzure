@if (CardChoiceModel is not null && CardAnswerModel is not null)
{
    <InputRadioGroup @bind-Value="CardAnswerModel.OperationType">
        @foreach (var operationType in CardChoiceModel.Operations)
        {
            string id = CardAnswerModel.Index + "-" + operationType;
            <InputRadio id="@id" class="btn-check" Value="@operationType" />
            <label class="btn btn-outline-primary" for="@id">@operationType</label>
        }
    </InputRadioGroup>
}