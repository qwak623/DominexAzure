@using Dominex.Web.Client.Pages.Menu;
@inject SinglePlayerSettingsState State

<div class="row">
    <!-- Selected cards -->
    <div class="col-6"
            ondragover="event.preventDefault();"
            @ondrop="e => OnDropToSelected(e)">
        <h4>Selected Cards:</h4>
        @foreach (var card in State.SelectedCards)
        {
            <DraggableCard Card="card" OnDragStart="e => OnDragStart(e, card)" />
        }
        <div>count: (@State.SelectedCards.Count/10)</div>
    </div>

    <!-- Not selected cards -->
    <div class="col-6"
            ondragover="event.preventDefault();"
            @ondrop="e => OnDropToAvailable(e)">
        <h4>Available Cards:</h4>
        @foreach (var card in State.AvailableCards)
        {
            <DraggableCard Card="card" OnDragStart="e => OnDragStart(e, card)" />
        }
    </div>
</div>