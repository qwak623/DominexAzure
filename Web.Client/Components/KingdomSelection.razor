@if (AvailableCards is not null)
{
    <div class="row">
        <!-- Selected cards -->
        <div class="col-6"
                ondragover="event.preventDefault();"
                @ondrop="e => OnDrop(e, SelectedCards)">
            <h4>Selected Cards:</h4>
            @foreach (var card in SelectedCards)
            {
                <DraggableCard Card="card" OnDragStart="e => OnDragStart(e, card)" />
            }
            <div>count: (@SelectedCards.Count/10)</div>
        </div>

        <!-- Not selected cards -->
        <div class="col-6"
                ondragover="event.preventDefault();"
                @ondrop="e => OnDrop(e, AvailableCards)">
            <h4>Available Cards:</h4>
            @foreach (var card in AvailableCards)
            {
                <DraggableCard Card="card" OnDragStart="e => OnDragStart(e, card)" />
            }
        </div>
    </div>
}