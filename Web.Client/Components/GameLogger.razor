@using Microsoft.AspNetCore.SignalR.Client;
@inject NavigationManager Navigation

<div class="gameLogger">
    @*<button @onclick="AppendLog">Append Log</button>*@
    @if (GameLogs is not null)
    {
        foreach (var record in GameLogs)
        {
            <div class="@GetPlayerLogsColor(record.PlayerId)">
                @if (record.PlayerId is not null)
                {
                    <span class="bold">@(record.PlayerId): </span>
                }
                <span>@record.Message</span>
            </div>
        }
    }
</div>