@attribute [Route(AppRoutes.Account.Login)]
@attribute [AllowAnonymous]
<div class="login-page d-flex flex-column align-items-center justify-content-center min-vh-100">
    <div class="login-card p-5 rounded-4 shadow text-center" style="width: 360px;">
        <h1 class="mb-1 fs-3 fw-bold">Dominex</h1>
        <p class="text-muted mb-4">Sign in to continue</p>

        <a href="authentication/login?returnUrl=@AppRoutes.Home" class="btn btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.7c-.5 2.8-2.2 5.2-4.7 6.8v5.6h7.6c4.5-4.1 7-10.2 7-16.4z" />
                <path fill="#34A853" d="M24 47c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.6c-2.2 1.5-5 2.3-8.3 2.3-6.4 0-11.8-4.3-13.7-10.1H2.5v5.8C6.4 41.8 14.6 47 24 47z" />
                <path fill="#FBBC05" d="M10.3 27.8A14.7 14.7 0 0 1 9.5 24c0-1.3.2-2.6.6-3.8v-5.8H2.5A23.9 23.9 0 0 0 0 24c0 3.9.9 7.5 2.5 10.8l7.8-7z" />
                <path fill="#EA4335" d="M24 9.5c3.5 0 6.7 1.2 9.2 3.6l6.9-6.9C35.9 2.4 30.4 0 24 0 14.6 0 6.4 5.2 2.5 13.2l7.8 5.8C12.2 13.8 17.6 9.5 24 9.5z" />
            </svg>
            Sign in with Google
        </a>
    </div>
</div>
