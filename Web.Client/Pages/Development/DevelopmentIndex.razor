@*@page "/development" *@
@attribute [Route(Routes.Development.Dev)]

<HxButton Color="ThemeColor.Primary" OnClick="Click"> Start </HxButton>
<div class="row">
    <NavPanel Title="Player State" Icon="BootstrapIcon.Box2Heart">
        <PlayerState />
    </NavPanel>
</div>
<div class="row">
    <div class="col-2">
        <NavPanel Title="Kingdom" Icon="BootstrapIcon.EmojiKiss">
            <Kingdom />
        </NavPanel>
    </div>
    <div class="col-5">
        <NavPanel Title="Cards to buy" Icon="BootstrapIcon.FileCode">
            @foreach (var card in Cards)
            {
                <HxButton Color="ThemeColor.Secondary" OnClick="() => SelectCard(card)">@card</HxButton>
            }
		</NavPanel>
    </div>

    <div class="col-5">
        <NavPanel Title="Game log" Icon="BootstrapIcon.Textarea">
            <GameLogger />
        </NavPanel>
    </div>
</div>