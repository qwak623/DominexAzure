		<AssemblyName>Dominex.Services</AssemblyName>
		<RootNamespace>Dominex.Services</RootNamespace>
		<ImplicitUsings>true</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Dominex.Services.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Havit.Extensions.DependencyInjection.Abstractions" />
